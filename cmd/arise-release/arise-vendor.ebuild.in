EAPI=8
inherit shell-completion go-module

DESCRIPTION="Experimental high-performance, recovery-oriented package manager for Gentoo"
HOMEPAGE="https://github.com/airencracken/arise"
ARISE_COMMIT="@ARISE_COMMIT@"
SRC_URI="
	https://github.com/airencracken/arise/archive/${ARISE_COMMIT}.tar.gz -> ${P}.tar.gz
	https://github.com/airencracken/arise-overlay-assets/releases/download/v${PV}/${P}-vendor.tar.xz
"
S="${WORKDIR}/arise-${ARISE_COMMIT}"

LICENSE="GPL-3 Apache-2.0 BSD BSD-2 MIT MPL-2.0"
SLOT="0"
KEYWORDS="~amd64"
IUSE="info pie rsync test"
RDEPEND="
	!sys-apps/arise-bin
	app-arch/bzip2
	app-arch/tar
	app-arch/xz-utils
	app-shells/bash
	rsync? ( net-misc/rsync )
	sys-apps/portage
	sys-apps/sandbox
	sys-apps/util-linux
"
BDEPEND="
	>=dev-lang/go-1.26.3
	sys-apps/file
	info? ( sys-apps/texinfo )
"
RESTRICT="!test? ( test )"

src_unpack() {
	default
	[[ -d ${WORKDIR}/vendor ]] || die "vendor archive is missing vendor/"
	[[ -f ${WORKDIR}/arise-vendor-manifest.json ]] ||
		die "vendor archive is missing its provenance manifest"
	mv "${WORKDIR}/vendor" "${S}/vendor" || die "could not install vendor tree"
	mv "${WORKDIR}/arise-vendor-manifest.json" "${S}/" ||
		die "could not install vendor provenance manifest"
}

src_prepare() {
	default
	mkdir -p "${T}/verify-cache" "${T}/verify-modcache" ||
		die "could not create verification caches"
	GOCACHE="${T}/verify-cache" GOMODCACHE="${T}/verify-modcache" GOPROXY=off \
		ego run -mod=vendor ./cmd/arise-vendor-manifest \
		-mode=verify -root . -output arise-vendor-manifest.json \
		-version "${PV}" -commit "${ARISE_COMMIT}" ||
		die "vendor provenance verification failed"
}

src_compile() {
	local buildmode=exe
	local linkage
	use pie && buildmode=pie
	CGO_ENABLED=0 GOPROXY=off ego build \
		-mod=vendor -buildmode="${buildmode}" -buildvcs=false -trimpath \
		-ldflags="-X main.version=${PV}" -o arise ./cmd/arise/
	linkage=$(file arise) || die "could not inspect built binary"
	if use pie; then
		[[ ${linkage} == *"pie executable"* ]] ||
			die "pie build must produce a PIE executable: ${linkage}"
	else
		[[ ${linkage} == *"statically linked"* ]] ||
			die "recovery build must produce a statically linked executable: ${linkage}"
	fi
	if use info; then
		texi2any --info arise.texi -o arise.info || die "Info generation failed"
	fi
}

src_test() {
	mkdir -p "${T}/test-home" || die "could not create isolated test home"
	env -i GOCACHE="${GOCACHE}" GOMODCACHE="${GOMODCACHE}" GOPROXY=off \
		HOME="${T}/test-home" PATH="${PATH}" TMPDIR="${T}" \
		go test -mod=vendor ./... -timeout 120s
}

src_install() {
	dobin arise
	doman arise.1
	use info && doinfo arise.info
	dodoc README.md LICENSE arise-vendor-manifest.json
	newbashcomp misc/arise-completion.bash arise
}

pkg_postinst() {
	elog "Arise is experimental; keep Portage installed as the reference and recovery implementation."
	elog "Run 'arise sync' to synchronize repositories and publish the resolver index."
	elog "Use 'arise --pretend <target>' to inspect a plan or 'arise install <target>' to execute it."
}
